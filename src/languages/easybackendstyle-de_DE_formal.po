msgid "background"
msgstr "Hintergrund"

#: easyBackendStyle.php:117
msgid "Sets the background color of the page"
msgstr "Legt die Hintergrundfarbe der Seite fest"

#: easyBackendStyle.php:118 src/deprecated/ebs_SettingsSubMenu.php:146
