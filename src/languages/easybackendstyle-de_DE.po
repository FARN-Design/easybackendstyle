#. Plugin Name of the plugin
#: easyBackendStyle.php
msgid "Easy Backend-Style"
msgstr "Easy Backend-Style"

#. Plugin URI of the plugin
#: easyBackendStyle.php
msgid "https://www.farnlabs.com/easy-backend-style"
msgstr "https://www.farnlabs.de/easy-backend-style"

#. Description of the plugin
#: easyBackendStyle.php
msgid "Easily modify your backend interface's color schemes for a fresh look using an automated color generation feature based on your base colors, and have advanced customization options to fine-tune your backend's appearance."
msgstr "Gestalte dein WordPress-Backend mit automatisch abgeleiteten Farben und passe einzelne Farben nach Bedarf an."

#. Author of the plugin
#: easyBackendStyle.php
msgid "FARN Labs"
msgstr "FARN Labs"

#. Author URI of the plugin
