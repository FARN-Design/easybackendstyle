{
  "name": "easybackendstyle-tests",
  "version": "1.0.0",
  "description": "Easy Backend Style release and regression tests",
  "type": "module",
  "scripts": {
    "test": "vitest run --config=tests/integration/vitest.config.ts && npx playwright test --config=tests/end-to-end/playwright.config.ts",
    "test:integration": "vitest --config=tests/integration/vitest.config.ts",
    "test:e2e": "npx playwright test --config=tests/end-to-end/playwright.config.ts",
    "build:colors": "python3 scripts/build-admin-colors.py",
    "test:colors": "python3 scripts/build-admin-colors.py --check && python3 tests/test_admin_colors.py"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.14.1",
    "@wp-playground/cli": "3.0.54",
    "fetch-cookie": "^3.1.0",
    "vitest": "^3.1.1"
  }
}
